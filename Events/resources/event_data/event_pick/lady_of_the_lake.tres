[resource]
script = ExtResource("1_b2srs")
narrative = "Searching through a room, you accidentally drop an item into a puddle. Somehow, it begins sinking. You could have sworn the water there wasn't more than a couple centimeters deep.

To make things even weirder, a ghostly figure rises up from the puddle, holding up two items that are definitely not what you dropped and asking you which one of them belongs to you. What do you say?"
choices = Array[ExtResource("1_6txf8")]([SubResource("Resource_u0lyd"), SubResource("Resource_5cwy6"), SubResource("Resource_md1uh")])
name = "Lady of the Puddle"
description = ""
rarity = 2
tags = Array[int]([0, 4])
secret = false
unique = true
goes_to_next_level = false
is_final_event = false
event_unlocks = Array[Resource("res://Events/EventData.gd")]([])
